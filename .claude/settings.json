{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/reprise-session.sh\"",
            "timeout": 45,
            "statusMessage": "Vérification du dépôt en ligne..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde-secrets.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
